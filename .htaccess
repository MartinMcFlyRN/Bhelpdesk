# Bhelpdesk - Apache, SOLO se non puoi impostare la document root su public/
# (es. hosting condiviso dove la root punta alla cartella del progetto).
# La soluzione consigliata resta document root = public/: in quel caso
# questo file non viene mai letto.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # cartelle e file interni mai raggiungibili
    RewriteRule ^(src|config|sql|templates|bin|deploy)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(README\.md|composer\.(json|lock))$ - [F,L]

    # tutto il resto viene servito da public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
