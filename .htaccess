# Bhelpdesk - Apache, ONLY if you cannot set the document root to public/
# (e.g. shared hosting where the root points to the project folder).
# Recommended setup is still document root = public/: then this file
# is never read.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # internal folders and files are never reachable
    RewriteRule ^(src|config|sql|templates|bin|deploy)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(README\.md|composer\.(json|lock))$ - [F,L]

    # everything else is served from public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
