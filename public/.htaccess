# Bhelpdesk - Apache (document root = public/)
# Requires: mod_rewrite, AllowOverride All (or at least FileInfo, Options, AuthConfig, Indexes)
# Ignored by nginx.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # no dotfiles (.git, .env, .htaccess...)
    RewriteRule (^|/)\. - [F]

    # / -> customers area, trailing slash on both areas
    RewriteRule ^$ /customer/ [R=302,L]
    RewriteRule ^(customer|op)$ /$1/ [R=301,L]

    # only index.php, customer/index.php and op/index.php are executable
    RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
    RewriteCond %{REQUEST_FILENAME} !/public/(customer/|op/)?index\.php$
    RewriteRule ^ - [R=404,L]

    # front controllers of the two areas (existing files, e.g. assets, are served directly)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^customer/ customer/index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^op/ op/index.php [L,QSA]
</IfModule>
