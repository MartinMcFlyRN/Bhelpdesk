# Bhelpdesk - operators area IP filter (Apache 2.4)
# Applies to all of /op/, including URLs rewritten to op/index.php.
# List allowed IPs/networks separated by spaces; everything else gets 403.

<IfModule mod_authz_core.c>
    Require ip 127.0.0.1 ::1
    # Require ip 203.0.113.10 198.51.100.0/24 2001:db8::/48
</IfModule>

# Rewrite rules live in public/.htaccess: do not add "RewriteEngine"
# here, or it would replace the rules of the parent directory.
